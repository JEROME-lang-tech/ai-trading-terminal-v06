# Copy to .env and fill in. Never commit .env.
# Every variable here is OPTIONAL — the app runs with zero configuration
# in paper/simulator mode.

# --- server ---
PORT=8000
DB_PATH=state/trader.db        # point at a mounted volume on ephemeral hosts
APP_TOKEN=                     # REQUIRED on any public URL; guards /api/control

# --- strategy ---
PROFILE=validated              # validated | conservative | moderate | aggressive
TICK_SECONDS=300               # how often the engine evaluates the market
SYMBOLS=BTC-USD,ETH-USD,SOL-USD
RISK_PER_TRADE=0.5             # % of equity risked per trade

# --- execution (leave on demo until you've finished the demo period) ---
VENUE=simulator                # simulator | mt5 | kraken
ACCOUNT_TYPE=demo              # demo | real

# --- MetaTrader 5 (demo and real differ ONLY in these three) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=                    # e.g. Broker-Demo  /  Broker-Live

# --- Kraken ---
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
